{
  "name": "phrasey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "test": "pnpm -r --filter './packages/**' test",
    "lint": "pnpm -r --filter './packages/**' lint",
    "dev": "pnpm --parallel --filter '@phrasey/server' --filter '@phrasey/client' dev",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}