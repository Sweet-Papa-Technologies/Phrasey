# Local OpenAI-compatible model server used by `corpus-gen generate`.
# Not committed with a real address: it is an unauthenticated endpoint on a
# private network and this repo is public.
PHRASEY_INFINITY_URL=http://<your-llm-host>:8080/v1
PHRASEY_INFINITY_MODEL=Qwen3.8-27B

# The Vertex/Gemini fallback shells out to the `assetforge` CLI and uses its
# own saved service-account credential — nothing to configure here.
