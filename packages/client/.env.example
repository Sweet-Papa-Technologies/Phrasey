# Game server origin. Absent ⇒ the client runs the in-memory mock transport,
# which is also what drives the landing page's live demo board.
VITE_SERVER_URL=https://phrasey-server-2ulse5y3hq-uc.a.run.app

# GA4 measurement id. Absent ⇒ analytics is inert no matter what a visitor
# consents to. Set this only once a GA4 property exists (design doc §8/§11);
# the consent machinery is fully functional and testable without it.
VITE_GA4_MEASUREMENT_ID=
